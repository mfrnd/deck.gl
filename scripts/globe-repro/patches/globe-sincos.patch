+// sin and cos at f32 accuracy on every renderer, see project_sincos_ in project.glsl.ts
+fn project_sincos_(x: f32) -> vec2<f32> {
+  let q = floor(x * (2.0 / PI) + 0.5);
+  let r = x - q * 1.5703125 - q * 4.837512969970703125e-4 - q * 7.549789954891882e-8;
+  let r2 = r * r;
+  let s = r + r * r2 * (-1.6666654611e-1 + r2 * (8.3321608736e-3 + r2 * -1.9515295891e-4));
+  let c = 1.0 - 0.5 * r2 + r2 * r2 * (4.166664568298827e-2 + r2 * (-1.388731625493765e-3 + r2 * 2.443315711809948e-5));
+  let quadrant = q - 4.0 * floor(q * 0.25);
+  if (quadrant < 0.5) {
+    return vec2<f32>(s, c);
+  }
+  if (quadrant < 1.5) {
+    return vec2<f32>(c, -s);
+  }
+  if (quadrant < 2.5) {
+    return vec2<f32>(-s, -c);
+  }
+  return vec2<f32>(-c, s);
+}
